# Production site URL (used for canonical links if needed)
# NEXT_PUBLIC_SITE_URL=https://alltoolstogether.com

# Optional backend for grammar, paraphrase, plagiarism, and URL shortener tools.
# Deploy the /backend Express service, then set this to its public URL.
# NEXT_PUBLIC_API_BASE=https://api.alltoolstogether.com
# Optional Bing Webmaster Tools ownership value; obtain it from your own account.
NEXT_PUBLIC_BING_VERIFICATION=

# Document Studio defaults to /api/documents (proxied to api.alltoolstogether.com).
# Override for a different deployment. Never place private server secrets here.
# NEXT_PUBLIC_DOCUMENT_API_BASE=https://api.alltoolstogether.com/api/documents
# Enable only after verifying every server tool with an individual page is available.
NEXT_PUBLIC_DOCUMENTS_READY=false
# Optional independently deployed BentoPDF workspace.
# NEXT_PUBLIC_BENTO_URL=https://pdf-workspace.alltoolstogether.com
