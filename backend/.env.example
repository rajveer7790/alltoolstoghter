# ---- ToolsWorld backend configuration ----
# Copy to .env and fill in. All are optional except the basics.

PORT=8787
# Comma-separated list of allowed origins (your frontend domain). Use * only for local testing.
CORS_ORIGIN=http://localhost:3000

# Public base URL of THIS backend, used to build short links (no trailing slash).
PUBLIC_BASE_URL=http://localhost:8787

# --- Grammar (LanguageTool) ---
# Free public endpoint works out of the box (rate-limited). For production, self-host
# LanguageTool (https://github.com/languagetool-org/languagetool) and set its URL here.
LANGUAGETOOL_URL=https://api.languagetool.org/v2/check

# --- Paraphrase (requires an LLM provider) ---
# OpenAI-compatible endpoint + key. Without these, the paraphrase endpoint returns a clear 503.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Plagiarism (requires a web-search provider) ---
# A search API key (e.g. Serper, Bing, Google CSE). Without it, the endpoint returns a clear 503.
SEARCH_API_URL=
SEARCH_API_KEY=
