FROM python:3.12-slim-bookworm
ARG ENGINE=docling
ENV MODEL_ENGINE=$ENGINE MODEL_PYTHON=/opt/modelenv/bin/python PATH=/opt/modelenv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HOME=/models/huggingface PADDLE_PDX_CACHE_HOME=/models/paddle OMP_NUM_THREADS=2
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libgl1 libgomp1 fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/documents/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
RUN python -m venv /opt/modelenv
RUN case "$ENGINE" in \
    docling) /opt/modelenv/bin/pip install --no-cache-dir docling ;; \
    paddle) /opt/modelenv/bin/pip install --no-cache-dir paddlepaddle 'paddleocr[doc-parser]==3.7.0' ;; \
    mineru) /opt/modelenv/bin/pip install --no-cache-dir 'mineru[torch]==4.2.3' ;; \
    geometric) /opt/modelenv/bin/pip install --no-cache-dir pdf2docx==0.5.13 PyMuPDF==1.26.7 'opencv-python-headless==5.1.0.95' ;; \
    marker) /opt/modelenv/bin/pip install --no-cache-dir marker-pdf==2.2.0 ;; \
    *) echo 'Unsupported engine' && exit 1 ;; esac
RUN useradd --uid 10001 --create-home worker && mkdir /models && chown worker /models
COPY backend/documents /app/backend/documents
COPY lib/documents/tools.json /app/lib/documents/tools.json
USER worker
EXPOSE 8790
CMD ["/usr/local/bin/python", "-m", "uvicorn", "backend.documents.app:app", "--host", "0.0.0.0", "--port", "8790", "--no-access-log", "--no-proxy-headers"]
